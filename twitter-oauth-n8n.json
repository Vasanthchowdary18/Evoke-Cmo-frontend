{
  "name": "Twitter OAuth Token Exchange",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twitter-oauth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-tw-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "twitter-oauth"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twitter.com/2/oauth2/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "specifyBody": "form",
        "bodyParameters": {
          "parameters": [
            { "name": "grant_type",    "value": "authorization_code" },
            { "name": "code",          "value": "={{ $json.body.code }}" },
            { "name": "redirect_uri",  "value": "={{ $json.body.redirectUri }}" },
            { "name": "client_id",     "value": "YOUR_TWITTER_CLIENT_ID_HERE" },
            { "name": "code_verifier", "value": "={{ $json.body.verifier }}" }
          ]
        },
        "options": {}
      },
      "id": "node-tw-002",
      "name": "Exchange Twitter Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.twitter.com/2/users/me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "node-tw-003",
      "name": "Get Twitter User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const accessToken = $('Exchange Twitter Token').item.json.access_token;\nconst user = $input.item.json.data;\nreturn [{\n  json: {\n    accessToken,\n    username: user.username,\n    userId: user.id,\n  }\n}];"
      },
      "id": "node-tw-004",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-tw-005",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Exchange Twitter Token", "type": "main", "index": 0 }]]
    },
    "Exchange Twitter Token": {
      "main": [[{ "node": "Get Twitter User", "type": "main", "index": 0 }]]
    },
    "Get Twitter User": {
      "main": [[{ "node": "Format Response", "type": "main", "index": 0 }]]
    },
    "Format Response": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
