# ─────────────────────────────────────────────────────────────────────────────
# EVOKE AI CMO — environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# NEVER commit real values. See docs/07-environment-and-deployment.md for the
# full annotated reference of what each variable does.
#
# `VITE_*` variables are bundled into the CLIENT and are PUBLIC once deployed.
# Anything that must stay secret belongs in a non-prefixed, server-only variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (client SDK) ────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (server-only — Vercel env, needed by api/brand-kb.js) ─────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Evoke SSO & platform ─────────────────────────────────────────────────────
VITE_ACCOUNTS_URL=
VITE_MARKETPLACE_URL=
VITE_API_BASE_URL=
VITE_COOKIE_DOMAIN=
VITE_EVOKE_API_KEY=
VITE_ADMIN_EMAIL=

# ── n8n automation backend ───────────────────────────────────────────────────
VITE_N8N_BASE=
VITE_N8N_WEBHOOK=
VITE_N8N_AGENT_WEBHOOK=
VITE_N8N_DAY_WEBHOOK=

# ── AI providers ─────────────────────────────────────────────────────────────
# Server-side (preferred — not exposed to the browser)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Client-side Groq key (exposed in the bundle — avoid if possible)
VITE_GROQ_API_KEY=
VITE_WAVESPEED_API_KEY=

# ── GoHighLevel (social publishing) ──────────────────────────────────────────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Private Integration Token — server-side only, never expose to the client
GHL_PIT_TOKEN=
VITE_GHL_LOCATION_ID=

# ── Meta / Facebook / Instagram ──────────────────────────────────────────────
VITE_META_APP_ID=
VITE_META_APP_SECRET=
VITE_META_API_BASE=
VITE_META_AD_ACCOUNT_ID=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
VITE_FB_PAGE_ID=
VITE_FB_PAGE_ACCESS_TOKEN=
VITE_FACEBOOK_PAGE_ID=
VITE_FACEBOOK_PAGE_ACCESS_TOKEN=
VITE_INSTAGRAM_ID=
VITE_INSTAGRAM_BUSINESS_ACCOUNT_ID=
VITE_INSTAGRAM_ACCESS_TOKEN=

# ── Other platforms ──────────────────────────────────────────────────────────
VITE_LINKEDIN_CLIENT_ID=
VITE_TWITTER_CLIENT_ID=
VITE_TIKTOK_CLIENT_ID=
VITE_TIKTOK_CLIENT_SECRET=
VITE_TIKTOK_REDIRECT_URI=
VITE_EVENTBRITE_CLIENT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Storage & payments ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_IMGBB_API_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_LINK_A=

# ── Supabase (schema built, not yet in the live path) ────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. NEVER prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ── EGT (blockchain rewards) ─────────────────────────────────────────────────
VITE_EGT_RPC_URL=
VITE_EGT_REWARD_POOL_ADDRESS=

# ── Email ────────────────────────────────────────────────────────────────────
# api/send-email.js returns HTTP 501 until RESEND_API_KEY is set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
